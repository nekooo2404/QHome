generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PROPERTY_RESIDENT_DATABASE_URL")
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ApartmentStatus {
  PLANNED
  AVAILABLE
  OCCUPIED
  HANDED_OVER
  MAINTENANCE
  INACTIVE
}

enum HandoverStatus {
  NOT_READY
  SCHEDULED
  HANDED_OVER
  REJECTED
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum ApartmentResidentRole {
  OWNER
  TENANT
  MEMBER
}

enum ApartmentResidentStatus {
  ACTIVE
  ENDED
  PENDING
}

enum VehicleType {
  CAR
  MOTORBIKE
  ELECTRIC_BICYCLE
  BICYCLE
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  LOST
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ImportStatus {
  CREATED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model Building {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  code        String         @db.VarChar(64)
  name        String         @db.VarChar(200)
  address     String?        @db.VarChar(500)
  status      BuildingStatus @default(ACTIVE)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  blocks          BuildingBlock[]
  apartments      Apartment[]
  contacts        ContactDirectoryEntry[]
  importJobs      ImportJob[]
  outboxEvents    OutboxEvent[]

  @@unique([projectId, code])
  @@index([projectId, status, updatedAt])
  @@index([projectId, name])
  @@map("buildings")
}

model BuildingBlock {
  id         String         @id @default(uuid()) @db.Uuid
  buildingId String         @db.Uuid
  code       String         @db.VarChar(64)
  name       String         @db.VarChar(200)
  status     BuildingStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  building  Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  floors    Floor[]
  apartments Apartment[]

  @@unique([buildingId, code])
  @@index([buildingId, status])
  @@map("building_blocks")
}

model Floor {
  id        String   @id @default(uuid()) @db.Uuid
  blockId   String   @db.Uuid
  floorNo   Int
  label     String   @db.VarChar(64)
  createdAt DateTime @default(now())

  block      BuildingBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  apartments Apartment[]

  @@unique([blockId, floorNo])
  @@index([blockId, floorNo])
  @@map("floors")
}

model Apartment {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  buildingId        String          @db.Uuid
  blockId           String          @db.Uuid
  floorId           String          @db.Uuid
  code              String          @db.VarChar(64)
  netAreaSqm        Decimal         @db.Decimal(12, 3)
  grossAreaSqm      Decimal?        @db.Decimal(12, 3)
  status            ApartmentStatus @default(PLANNED)
  handoverStatus    HandoverStatus   @default(NOT_READY)
  handedOverAt      DateTime?
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  building          Building              @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  block             BuildingBlock          @relation(fields: [blockId], references: [id], onDelete: Restrict)
  floor             Floor                 @relation(fields: [floorId], references: [id], onDelete: Restrict)
  residents         ApartmentResidentMap[]
  activeContexts    ActiveApartmentContext[]
  vehicles          Vehicle[]

  @@unique([buildingId, code])
  @@index([projectId, buildingId, status, updatedAt])
  @@index([buildingId, blockId, floorId, code])
  @@index([projectId, handoverStatus])
  @@map("apartments")
}

model Resident {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @db.Uuid
  externalRef  String         @unique @db.VarChar(128)
  fullName     String         @db.VarChar(200)
  phone        String?        @db.VarChar(32)
  email        String?        @db.VarChar(320)
  status       ResidentStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  apartments   ApartmentResidentMap[]
  vehicles     Vehicle[]
  activeContexts ActiveApartmentContext[]

  @@index([fullName])
  @@index([phone])
  @@index([status, updatedAt])
  @@map("residents")
}

model ApartmentResidentMap {
  id                 String                   @id @default(uuid()) @db.Uuid
  apartmentId        String                   @db.Uuid
  residentId         String                   @db.Uuid
  role               ApartmentResidentRole
  status             ApartmentResidentStatus @default(ACTIVE)
  isPrimaryHousehold Boolean                  @default(false)
  startsAt           DateTime                 @default(now())
  endsAt             DateTime?
  activeMapKey       String?                  @unique @db.VarChar(180)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  resident  Resident  @relation(fields: [residentId], references: [id], onDelete: Restrict)

  @@index([residentId, status, startsAt])
  @@index([apartmentId, status, role])
  @@index([residentId, apartmentId, status])
  @@map("apartment_resident_map")
}

model ActiveApartmentContext {
  id          String   @id @default(uuid()) @db.Uuid
  residentId  String   @db.Uuid
  projectId   String   @db.Uuid
  apartmentId String   @db.Uuid
  selectedAt  DateTime @default(now())
  version     Int      @default(1)

  resident  Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@unique([residentId, projectId])
  @@index([residentId, selectedAt])
  @@map("active_apartment_contexts")
}

model Vehicle {
  id                  String        @id @default(uuid()) @db.Uuid
  residentId          String        @db.Uuid
  apartmentId         String        @db.Uuid
  externalRef         String        @unique @db.VarChar(128)
  type                VehicleType
  licensePlate        String        @db.VarChar(32)
  registrationNumber  String?       @db.VarChar(128)
  registrationObjectRef String?     @db.VarChar(500)
  status              VehicleStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  resident  Resident  @relation(fields: [residentId], references: [id], onDelete: Restrict)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@unique([apartmentId, licensePlate])
  @@index([residentId, status, updatedAt])
  @@index([apartmentId, status])
  @@index([licensePlate])
  @@map("vehicles")
}

model ContactDirectoryEntry {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  buildingId   String        @db.Uuid
  departmentId String        @db.Uuid
  name         String        @db.VarChar(200)
  title        String?       @db.VarChar(200)
  phone        String?       @db.VarChar(32)
  email        String?       @db.VarChar(320)
  extension    String?       @db.VarChar(32)
  priority     Int           @default(100)
  status       ContactStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@index([projectId, buildingId, departmentId, status, priority])
  @@index([buildingId, status, name])
  @@map("contact_directory_entries")
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  buildingId  String?      @db.Uuid
  fileName    String       @db.VarChar(255)
  status      ImportStatus @default(CREATED)
  totalRows   Int          @default(0)
  successRows Int          @default(0)
  failedRows  Int          @default(0)
  errorCount  Int          @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?      @db.VarChar(2000)
  createdAt   DateTime     @default(now())

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@map("import_jobs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  buildingId    String?   @db.Uuid
  eventId       String    @unique @db.Uuid
  eventType     String    @db.VarChar(160)
  aggregateType String    @db.VarChar(96)
  aggregateId   String    @db.VarChar(128)
  topic         String    @default("qhome.property-resident.events.v1") @db.VarChar(200)
  payload       Json
  headers       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leasedUntil   DateTime?
  leaseOwner    String?   @db.VarChar(128)
  lastError     String?   @db.VarChar(2000)

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([projectId, publishedAt, nextAttemptAt, leasedUntil])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model ResidentChangeLog {
  id           String   @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  residentId   String   @db.Uuid
  changeType   String   @db.VarChar(96)
  payload      Json
  occurredAt   DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([residentId, occurredAt])
  @@id([id, occurredAt])
  @@map("resident_change_log")
}
