generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("RESIDENT_REGISTRATION_DATABASE_URL")
}

enum AmenityStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum RegistrationType {
  VEHICLE
  ELEVATOR_CARD
  PARKING_CARD
  APARTMENT_ACCESS_CARD
  REPAIR
  MOVING
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
}

enum PassStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

model Amenity {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  buildingId  String        @db.Uuid
  code        String        @db.VarChar(96)
  name        String        @db.VarChar(240)
  description String?       @db.VarChar(2000)
  capacity    Int
  status      AmenityStatus @default(ACTIVE)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slots    AmenityTimeSlot[]
  bookings AmenityBooking[]

  @@unique([projectId, code])
  @@index([projectId, buildingId, status])
  @@map("amenities")
}

model AmenityTimeSlot {
  id            String   @id @default(uuid()) @db.Uuid
  amenityId     String   @db.Uuid
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  reservedCount Int      @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  amenity  Amenity          @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  bookings AmenityBooking[]

  @@unique([amenityId, startsAt, endsAt])
  @@index([amenityId, startsAt, endsAt, reservedCount])
  @@map("amenity_time_slots")
}

model AmenityBooking {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @db.Uuid
  residentId     String        @db.Uuid
  apartmentId    String        @db.Uuid
  amenityId      String        @db.Uuid
  timeSlotId     String        @db.Uuid
  idempotencyKey String        @db.VarChar(160)
  status         BookingStatus @default(HELD)
  partySize      Int           @default(1)
  startsAt       DateTime
  endsAt         DateTime
  paymentDueAt   DateTime?
  paymentRef     String?       @db.VarChar(160)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  amenity  Amenity         @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  timeSlot AmenityTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, residentId, status, startsAt])
  @@index([amenityId, timeSlotId, status])
  @@map("amenity_bookings")
}

model RegistrationRequest {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  residentId     String           @db.Uuid
  apartmentId    String           @db.Uuid
  type           RegistrationType
  status         WorkflowStatus   @default(DRAFT)
  idempotencyKey String           @db.VarChar(160)
  payload        Json
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  version        Int              @default(1)

  approvals ApprovalAction[]
  passes    SecurityPass[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, residentId, status, type])
  @@index([projectId, apartmentId, createdAt])
  @@map("registration_requests")
}

model ApprovalAction {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  step       Int
  approverId String           @db.Uuid
  decision   ApprovalDecision
  comment    String?          @db.VarChar(2000)
  decidedAt  DateTime         @default(now())

  request RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, step])
  @@index([approverId, decidedAt])
  @@map("approval_actions")
}

model SecurityPass {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  requestId   String     @db.Uuid
  jti         String     @unique @db.VarChar(160)
  payloadHash String     @db.Char(64)
  validFrom   DateTime
  expiresAt   DateTime
  status      PassStatus @default(ACTIVE)
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  request RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([projectId, status, expiresAt])
  @@index([requestId, status])
  @@map("security_passes")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String?   @db.Uuid
  eventId       String    @unique @db.VarChar(160)
  topic         String    @db.VarChar(200)
  eventType     String    @db.VarChar(160)
  aggregateType String    @db.VarChar(96)
  aggregateId   String    @db.VarChar(160)
  payload       Json
  headers       Json      @default("{}")
  status        String    @default("PENDING") @db.VarChar(32)
  attempts      Int       @default(0)
  occurredAt    DateTime  @default(now())
  nextAttemptAt DateTime  @default(now())
  publishedAt   DateTime?
  leasedUntil   DateTime?
  leaseOwner    String?   @db.VarChar(128)
  lastError     String?   @db.VarChar(2000)

  @@index([status, nextAttemptAt, leasedUntil])
  @@index([projectId, occurredAt])
  @@map("outbox_events")
}
